{
	# RSA certificate – compatible with PLC TLS 1.2 stacks (also used by Mosquitto on 8883)
	key_type rsa2048
}

{$DOMAIN} {
	encode gzip
	handle /api/* {
		reverse_proxy backend:8001
	}
	handle {
		root * /srv
		@static path /static/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		@nocache not path /static/*
		header @nocache Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

www.{$DOMAIN} {
        redir https://{$DOMAIN}{uri} permanent
}
